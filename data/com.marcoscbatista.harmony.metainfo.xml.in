<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.marcoscbatista.harmony</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Harmony</name>
  <summary>Explore color harmonies</summary>
  <description>
    <p>Explore relationships between colors with an interactive color harmony wheel. Choose a base color and discover complementary, triadic, and square harmonies.</p>
    <p>Click a color in the wheel to copy its HEX value to the clipboard.</p>
  </description>
  <developer>
    <name>Marcos Coelho</name>
  </developer>

  <url type="homepage">https://github.com/marcoscbatista/harmony</url>
  <url type="vcs-browser">https://github.com/marcoscbatista/harmony</url>
  <url type="bugtracker">https://github.com/marcoscbatista/harmony/issues</url>
  <url type="help">https://github.com/marcoscbatista/harmony#readme</url>
  <url type="contact">https://github.com/marcoscbatista/harmony/issues</url>

  <translation type="gettext">harmony</translation>
  <!-- All graphical applications having a desktop file must have this tag in the MetaInfo.
     If this is present, appstreamcli compose will pull icons, keywords and categories from the desktop file. -->
  <launchable type="desktop-id">com.marcoscbatista.harmony.desktop</launchable>
  <!-- Use the OARS website (https://hughsie.github.io/oars/generate.html) to generate these and make sure to use oars-1.1 -->
  <content_rating type="oars-1.1" />

  <!-- Applications should set a brand color in both light and dark variants like so -->
  <branding>
    <color type="primary" scheme_preference="light">#ff00ff</color>
    <color type="primary" scheme_preference="dark">#993d3d</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/marcoscbatista/harmony/main/screenshot.png</image>
      <caption>Harmony displaying a complementary color palette</caption>
    </screenshot>
  </screenshots>

  <releases>
  <release version="0.1.0" date="2026-09-05">
    <description>
      <p>Initial release.</p>
      <ul>
        <li>Explore complementary, triadic, and square color harmonies.</li>
        <li>Copy colors to the clipboard by clicking the color wheel.</li>
      </ul>
    </description>
  </release>
  </releases>

</component>
